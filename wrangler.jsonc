{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-app",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "ORBIT_KV",
      "id": "7af81da1df64490f9f69aa74c79d9053"
    }
  ]
}
